{
  "manifest_version": 3,
  "name": "Forge Tab",
  "short_name": "Forge Tab",
  "version": "1.0.0",
  "description": "A fast new tab with unlimited shortcuts in groups, type-to-launch, notes, saved commands and site status checks.",
  "minimum_chrome_version": "116",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "unlimitedStorage", "favicon", "search"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
